generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles: SUPER_ADMIN | ADMIN | CLERK | DEALER
model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 String
  access               String    @default("READ_WRITE") // NONE | READ_WRITE | READ_ONLY (account-level master)
  permsJson            String? // per-function permissions {fnKey: NONE|READ_WRITE|READ_ONLY}; null = role defaults
  companyIdsJson       String? // JSON array of Company ids this user may access; null = primary company only
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id])
  createdAt            DateTime  @default(now())
  // Two-factor authentication (TOTP). Secrets are AES-256-GCM encrypted at rest — never exposed after setup.
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecretEnc   String? // encrypted verified TOTP secret
  pendingTotpSecretEnc String? // encrypted secret during enrollment, before first successful code
  twoFactorEnabledAt   DateTime?

  salesOrders      SalesOrder[]
  stockMoves       StockMovement[]
  expenses         Expense[]
  notifications    Notification[]
  evaluations      Evaluation[]
  sessions         AuthSession[]
  recoveryCodes    RecoveryCode[]
  trustedDevices   TrustedDevice[]
  securityEvents   SecurityEvent[]
  grnCreated       GoodsReceipt[]        @relation("GRNCreated")
  grnPosted        GoodsReceipt[]        @relation("GRNPosted")
  receivedPayments ReceivePayment[]
  rcCreated        RefundCredit[]        @relation("RCCreated")
  rcApproved       RefundCredit[]        @relation("RCApproved")
  appSettings      AppSetting[]
  periodChanges    AccountingPeriod[]
  billsCreated     SupplierBill[]        @relation("BillCreated")
  billsPosted      SupplierBill[]        @relation("BillPosted")
  billsVoided      SupplierBill[]        @relation("BillVoided")
  dvPrepared       DisbursementVoucher[] @relation("DVPrepared")
  dvChecked        DisbursementVoucher[] @relation("DVChecked")
  dvApproved       DisbursementVoucher[] @relation("DVApproved")
  dvNoted          DisbursementVoucher[] @relation("DVNoted")
  dvPosted         DisbursementVoucher[] @relation("DVPosted")
  dvVoided         DisbursementVoucher[] @relation("DVVoided")
  paymentsMade     SupplierPayment[]     @relation("PaymentCreated")
  paymentsVoided   SupplierPayment[]     @relation("PaymentVoided")
}

/// Server-side sessions: the cookie holds a random token; only its SHA-256 hash is stored.
/// pendingTwoFactor=true rows are password-verified but NOT authenticated until TOTP succeeds.
model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  userAgent        String?
  ip               String?
  pendingTwoFactor Boolean   @default(false)
  stepUpAt         DateTime? // last fresh password/2FA confirmation (step-up auth for sensitive actions)
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

/// One-time 2FA recovery codes, stored hashed.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// "Remember this device" tokens (30-day expiry): skip TOTP on trusted devices. Hash stored only.
model TrustedDevice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

/// Security audit trail. NEVER contains passwords, secrets, codes, or tokens.
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String? // identifier attempted (for failed logins with no user match)
  action    String // LOGIN_SUCCESS | LOGIN_FAILED | TWO_FACTOR_* | RECOVERY_CODE_USED | PASSWORD_CHANGED | SESSION_REVOKED | ...
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, action, createdAt])
  @@index([ip, action, createdAt])
  @@index([userId, createdAt])
}

model Customer {
  id              String   @id @default(cuid())
  businessName    String
  contactPerson   String
  mobile          String
  messengerHandle String?
  address         String?
  region          String // Luzon | Visayas | Mindanao
  province        String
  creditLimit     Float    @default(0)
  allowedTerms    String // comma list: COD,30,60,90
  status          String   @default("Active")
  createdAt       DateTime @default(now())

  // the employee who owns this account. One salesperson may hold many customers.
  salespersonId String?
  salesperson   Employee? @relation(fields: [salespersonId], references: [id])

  receivePayments ReceivePayment[]
  refundCredits   RefundCredit[]

  users          User[]
  forecastLines  ForecastLine[]
  incomingOrders IncomingOrder[]
  salesOrders    SalesOrder[]
  salesReceipts  SalesReceipt[]
}

// Shared product category list (both companies) — name feeds Product.category,
// prefix drives the automatic PREFIX-### SKU numbering.
model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  prefix    String   @unique // SKU prefix, e.g. INS
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  contact String?
  address String?
  status  String  @default("Active") // Active | Inactive

  products       Product[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  vouchers       DisbursementVoucher[]
  payments       SupplierPayment[]
}

model Product {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  sku               String // unique per company (see @@unique below) — both companies may use the same code
  name              String
  activeIngredient  String
  category          String // Insecticide | Herbicide | Fungicide | Molluscicide | Foliar Fertilizer | Others
  itemClass         String    @default("INVENTORY") // INVENTORY (merchandise) | NON_INVENTORY (promo materials — stock + cost tracked, no SRP)
  cropTags          String // comma list
  packSize          String
  unitCost          Float
  dealerPrice       Float
  srp               Float
  reorderPoint      Int       @default(10)
  stockQty          Int       @default(0)
  batchNo           String?
  mfgDate           DateTime?
  expDate           DateTime?
  parentItem        String? // manual grouping label, e.g. "FungiStop 50 SC"; null = standalone row
  // Packaging: PCS is always the base inventory unit; CARTON is a selling/purchasing unit only.
  piecesPerCarton   Int? // null = product not sold by carton
  cartonDealerPrice Float? // override; null = dealerPrice × piecesPerCarton
  packGrossWeightKg Float? // gross weight (kg) of one selling pack: the carton when configured, else one piece; null = not maintained
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  status            String    @default("Active")
  createdAt         DateTime  @default(now())

  stockMoves         StockMovement[]
  incomingOrderLines IncomingOrderLine[]
  salesOrderLines    SalesOrderLine[]
  drLines            DRLine[]
  poLines            POLine[]
  grnLines           GRNLine[]
  forecastLines      ForecastLine[]
  refundCreditLines  RefundCreditLine[]
  billLines          SupplierBillLine[]

  @@unique([companyId, sku])
}

model StockMovement {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  // qty/balanceAfter are ALWAYS in PCS (base unit). enteredQty/enteredUnit record what the user typed.
  // qty is signed for ADJUST (negative = stock removed); IN/OUT store positive qty with direction in `type`.
  // `date` is the EFFECTIVE date (drives the stock card and all inventory calculations);
  // `createdAt` is when the row was actually entered (audit trail).
  createdAt    DateTime @default(now())
  enteredQty   Int?
  enteredUnit  String?
  type         String // IN | OUT | ADJUST
  qty          Int
  balanceAfter Int
  refType      String? // PO | DR | OPENING | ADJUST
  refNo        String?
  supplierRef  String? // supplier document on a receipt, e.g. their DR number
  date         DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}

model IncomingOrder {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  source           String // PORTAL | MESSENGER | TEXT
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  term             String // COD | 30 | 60 | 90
  status           String   @default("Pending") // Pending | Converted | Cancelled
  notes            String?
  orderNo          String? // order inbox number, unique per company (see @@unique below)
  orderDate        DateTime @default(now()) // when the transaction actually happened (backdatable); createdAt = when encoded
  freightPerCarton Float    @default(0) // ₱ per carton, charged to the customer
  freightTotal     Float    @default(0) // rate × cartons on CARTON lines, snapshotted at encode time
  createdAt        DateTime @default(now())

  lines       IncomingOrderLine[]
  salesOrders SalesOrder[]
}

model IncomingOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     IncomingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  qty       Int // in `unit`
  unit      String        @default("PCS") // PCS | CARTON
  baseQty   Int           @default(0) // qty converted to PCS at entry time
  unitPrice Float // price per `unit`
}

model SalesOrder {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  soNumber        String // unique per company (@@unique below)
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  incomingOrderId String?
  incomingOrder   IncomingOrder? @relation(fields: [incomingOrderId], references: [id])
  term            String
  status          String         @default("Draft") // Draft | Confirmed | Scheduled | Delivered | Invoiced | Closed | Cancelled
  orderDate       DateTime       @default(now())
  freightCharge   Float          @default(0) // total freight billed to the customer, carried from the incoming order
  preparedById    String?
  preparedBy      User?          @relation(fields: [preparedById], references: [id])
  voidReason      String?
  createdAt       DateTime       @default(now())

  lines            SalesOrderLine[]
  schedule         DeliverySchedule?
  deliveryReceipts DeliveryReceipt[]

  @@unique([companyId, soNumber])
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int // in `unit`
  unit         String     @default("PCS") // PCS | CARTON
  baseQty      Int        @default(0) // qty converted to PCS at entry time
  unitPrice    Float // price per `unit`
  discount     Float      @default(0)
  lineTotal    Float
}

model DeliverySchedule {
  id           String     @id @default(cuid())
  salesOrderId String     @unique
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  date         DateTime
  truck        String?
  driver       String?
  status       String     @default("Scheduled") // Scheduled | Loading | In Transit | Delivered
  createdAt    DateTime   @default(now())
}

model DeliveryReceipt {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  drNumber      String // unique per company (@@unique below)
  salesOrderId  String
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id])
  status        String     @default("Draft") // Draft | Delivered | Invoiced | Void
  date          DateTime   @default(now())
  deliveredAt   DateTime?
  // legacy free text, kept so old receipts are not rewritten; the links below win when set
  preparedBy    String?
  checkedBy     String?
  approvedBy    String?
  // the signatories this receipt was raised under, copied from the company defaults and
  // changeable by an authorised user (recorded in the audit trail)
  preparedById  String?
  preparedByEmp Employee?  @relation("DRPrepared", fields: [preparedById], references: [id])
  checkedById   String?
  checkedByEmp  Employee?  @relation("DRChecked", fields: [checkedById], references: [id])
  approvedById  String?
  approvedByEmp Employee?  @relation("DRApproved", fields: [approvedById], references: [id])
  voidReason    String?

  lines        DRLine[]
  salesReceipt SalesReceipt?

  @@unique([companyId, drNumber])
}

model DRLine {
  id                String          @id @default(cuid())
  deliveryReceiptId String
  deliveryReceipt   DeliveryReceipt @relation(fields: [deliveryReceiptId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  qty               Int // in `unit`
  unit              String          @default("PCS") // PCS | CARTON
  baseQty           Int             @default(0) // qty converted to PCS; stock is deducted by this
  unitPrice         Float // price per `unit`
  // batch/lot reference typed by the warehouse when picking, printed on the delivery
  // receipt. Free text (one or several batches) and a SNAPSHOT: editing the product's
  // batch number later must never rewrite what a signed delivery receipt said.
  batchNo           String?
  unitCostAtSale    Float           @default(0) // weighted-average cost per PCS captured when delivered (0 = pre-feature row; COGS falls back to current product cost)
  grossWeightKg     Float           @default(0) // TOTAL gross weight (kg) of this line captured when delivered — historical, unaffected by later packaging changes
}

model SalesReceipt {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  srNumber          String // unique per company (@@unique below)
  deliveryReceiptId String          @unique
  deliveryReceipt   DeliveryReceipt @relation(fields: [deliveryReceiptId], references: [id])
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  /// TOTAL INVOICE AMOUNT — product sales + freight + other charges.
  /// Never the product-sales figure: reports that measure product performance read the
  /// invoice lines, and the two components below, rather than this total.
  amount            Float
  freightCharge     Float           @default(0) // delivery charge billed to the customer
  /// any non-product charge billed on the invoice, kept apart from product revenue
  otherCharges      Float           @default(0)
  otherChargesNote  String?
  term              String
  vatApplied        Boolean         @default(true) // false = VAT-exempt / non-VAT sale
  invoiceDate       DateTime        @default(now())
  dueDate           DateTime
  status            String          @default("Open") // Open | Partial | Paid | Void
  voidReason        String?

  payments            Payment[]
  paymentApplications PaymentApplication[]
  refundCredits       RefundCredit[]
  creditApplications  CreditApplication[]

  @@unique([companyId, srNumber])
}

model Payment {
  id             String       @id @default(cuid())
  salesReceiptId String
  salesReceipt   SalesReceipt @relation(fields: [salesReceiptId], references: [id])
  amount         Float
  date           DateTime     @default(now())
  method         String // Cash | Check | Bank Transfer | GCash
  refNo          String?

  // set when this row was produced by posting a Receive Payment application or a
  // credit memo application; legacy rows recorded straight on the invoice stay null
  application       PaymentApplication?
  creditApplication CreditApplication?
}

/// A cash or bank account per company — a simple register with a running balance,
/// deliberately not a general ledger. Posted customer payments flow in here.
model CashAccount {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  name           String // e.g. Cash on Hand, BDO Checking #1234
  type           String     @default("Cash") // Cash | Bank | E-Wallet
  openingBalance Float      @default(0)
  status         String     @default("Active")
  // which Chart of Accounts entry this physical account books to
  glAccountId    String?
  glAccount      GLAccount? @relation(fields: [glAccountId], references: [id])

  payments         ReceivePayment[]
  refundCredits    RefundCredit[]
  supplierPayments SupplierPayment[]
}

/// A provisional receipt: one customer payment, applied to one or more of that
/// company's invoices. Draft → Pending Approval → Posted; only Posted touches AR.
model ReceivePayment {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  prNumber      String // PR-2026-00001, per company
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  date          DateTime     @default(now())
  amount        Float
  method        String // Cash | Check | Bank Transfer | GCash
  cashAccountId String?
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id])
  refNo         String?
  checkNo       String?
  checkDate     DateTime?
  remarks       String?
  receivedById  String?
  receivedBy    User?        @relation(fields: [receivedById], references: [id])
  status        String       @default("Draft") // Draft | Pending Approval | Posted | Cancelled | Void
  voidReason    String?
  createdAt     DateTime     @default(now())

  applications PaymentApplication[]
  refunds      RefundCredit[] // refunds drawing down this payment's unapplied credit

  @@unique([companyId, prNumber])
}

/// Refunds & Credits: a Credit memo builds customer credit (or offsets an invoice);
/// a Refund pays money back out. Draft → Pending Approval → Approved → Posted,
/// plus Rejected and Void. Only Posted documents touch AR, credit, cash or stock.
model RefundCredit {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  rcNumber        String // CM-2026-00001 (credit) or RF-2026-00001 (refund), per company
  type            String // Credit | Refund
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  salesReceiptId  String? // the related invoice, when there is one
  salesReceipt    SalesReceipt?   @relation(fields: [salesReceiptId], references: [id])
  date            DateTime        @default(now())
  reason          String // Sales Return | Overpayment | Pricing Adjustment | Damaged Product | Incorrect Billing | Others
  remarks         String
  amount          Float // from the item lines, or typed directly for an amount-only document
  status          String          @default("Draft") // Draft | Pending Approval | Approved | Posted | Rejected | Void
  voidReason      String?
  createdById     String?
  createdBy       User?           @relation("RCCreated", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?           @relation("RCApproved", fields: [approvedById], references: [id])
  // refund payout, recorded when the refund is posted
  refundMethod    String?
  refundRefNo     String?
  refundDate      DateTime?
  cashAccountId   String?
  cashAccount     CashAccount?    @relation(fields: [cashAccountId], references: [id])
  // a refund of an overpayment draws down that payment's unapplied credit …
  sourcePaymentId String?
  sourcePayment   ReceivePayment? @relation(fields: [sourcePaymentId], references: [id])
  // … or the remaining balance of an earlier credit memo
  sourceCreditId  String?
  sourceCredit    RefundCredit?   @relation("RefundOfCredit", fields: [sourceCreditId], references: [id])
  refundsDrawn    RefundCredit[]  @relation("RefundOfCredit")
  createdAt       DateTime        @default(now())

  lines        RefundCreditLine[]
  applications CreditApplication[]

  @@unique([companyId, rcNumber])
}

model RefundCreditLine {
  id             String       @id @default(cuid())
  refundCreditId String
  refundCredit   RefundCredit @relation(fields: [refundCreditId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  description    String? // free text for amount-only / non-product lines
  qty            Int          @default(1)
  unitPrice      Float
  returnToStock  Boolean      @default(false) // ticked = the goods came back and re-enter inventory on posting
}

/// A posted credit memo applied to one invoice — materialised as a legacy Payment row,
/// the same pattern Receive Payment uses, so AR and every report read it natively.
model CreditApplication {
  id             String       @id @default(cuid())
  refundCreditId String
  refundCredit   RefundCredit @relation(fields: [refundCreditId], references: [id], onDelete: Cascade)
  salesReceiptId String
  salesReceipt   SalesReceipt @relation(fields: [salesReceiptId], references: [id])
  amount         Float
  createdAt      DateTime     @default(now())
  paymentId      String?      @unique
  payment        Payment?     @relation(fields: [paymentId], references: [id])
}

/// How much of a receive-payment went to one invoice. Posting creates a matching
/// legacy Payment row per application, so AR aging, collections, the invoice screens
/// and the P&L keep reading the records they always have. The unapplied remainder
/// (payment amount − applications) is the customer's credit.
model PaymentApplication {
  id               String         @id @default(cuid())
  receivePaymentId String
  receivePayment   ReceivePayment @relation(fields: [receivePaymentId], references: [id], onDelete: Cascade)
  salesReceiptId   String
  salesReceipt     SalesReceipt   @relation(fields: [salesReceiptId], references: [id])
  amount           Float
  createdAt        DateTime       @default(now())
  paymentId        String?        @unique
  payment          Payment?       @relation(fields: [paymentId], references: [id])
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  poNumber   String // unique per company (@@unique below)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  status     String   @default("Draft") // Draft | Sent | Partially Received | Received | Cancelled
  voidReason String?
  date       DateTime @default(now())

  lines         POLine[]
  goodsReceipts GoodsReceipt[]
  bills         SupplierBill[]

  @@unique([companyId, poNumber])
}

/// Goods Received Note. Receiving is a DOCUMENT: nothing reaches inventory until it is
/// Posted, so a receipt can be drafted, inspected and corrected first. One purchase order
/// may have several, which is how partial deliveries are handled.
model GoodsReceipt {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  grnNumber         String // unique per company (@@unique below)
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  // Draft | Pending Inspection | Received | Posted | Rejected | Void
  status            String        @default("Draft")
  receivedDate      DateTime      @default(now())
  warehouse         String? // where the goods landed — a label, stock itself is not per-location
  deliveryRefNo     String? // the supplier's own DR number, used to catch a duplicate delivery
  supplierInvoiceNo String?
  remarks           String?
  // override trail: set when the receipt exceeded the PO's remaining qty or changed a cost
  overrideReason    String?
  postedAt          DateTime?
  postedById        String?
  postedBy          User?         @relation("GRNPosted", fields: [postedById], references: [id])
  createdById       String?
  createdBy         User?         @relation("GRNCreated", fields: [createdById], references: [id])
  voidReason        String?
  createdAt         DateTime      @default(now())
  /// When this receipt's accepted quantities went into stock — set on posting. The bill
  /// raised against it never adds quantity again; it re-costs what is on hand.
  stockedAt         DateTime?

  /// Pending | Entered | Partial | Billed | Discrepancy — how the supplier bills stand against this
  /// receipt. Kept in step by bill-matching.ts whenever a bill against it changes.
  invoiceStatus     String  @default("Pending")
  /// true when a Super Admin marked the receipt as billed and settled outside the BMS (before
  /// Enter Bills existed) — it counts as Billed and no bill is expected for it
  billedOutside     Boolean @default(false)
  billedOutsideNote String?

  lines GRNLine[]
  bills SupplierBill[]

  @@unique([companyId, grnNumber])
  @@index([purchaseOrderId])
}

model GRNLine {
  id              String       @id @default(cuid())
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLineId        String
  poLine          POLine       @relation(fields: [poLineId], references: [id])
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  // quantities are in the PO line's unit; the *BaseQty fields are the same in PCS
  qty             Int // delivered
  unit            String       @default("PCS")
  baseQty         Int
  acceptedQty     Int          @default(0)
  acceptedBaseQty Int          @default(0)
  rejectedQty     Int          @default(0) // damaged or refused — never added to stock
  rejectReason    String?
  unitCost        Float // ACTUAL cost on this delivery, per unit
  poUnitCost      Float // what the PO said, kept so a difference is visible forever
  batchNo         String?
  expDate         DateTime?

  @@index([goodsReceiptId])
}

model POLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  qty             Int // in `unit`
  unit            String        @default("PCS") // PCS | CARTON
  baseQty         Int           @default(0) // ordered qty converted to PCS
  receivedQty     Int           @default(0) // ACCEPTED qty in `unit` — rejected goods stay outstanding
  unitCost        Float // cost per `unit`

  grnLines GRNLine[]
}

/// An expense voucher.
///
/// Four dates that are deliberately NOT the same thing:
///   voucherDate   decides the accounting year, the period and the number series
///   date          the actual date on the invoice or receipt
///   receivedDate  when the company received the document
///   createdAt     when it was typed into the BMS
/// A late-December invoice received in January is voucher-dated 31 December, so it keeps a
/// December number and lands in the December period, however long afterwards it is encoded.
model Expense {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  /// ACTUAL EXPENSE DATE — what the invoice or receipt itself says
  date      DateTime @default(now())
  category  String // Fuel | Salaries | Utilities | Freight | Rent | Supplies | Others
  amount    Float
  notes     String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  /// EV-TTC-2026-000001 — unique per company, never reused
  voucherNo       String?
  /// drives the number series, the accounting year and the accounting period
  voucherDate     DateTime   @default(now())
  /// when the document reached the company
  receivedDate    DateTime?
  payee           String?
  /// derived from voucherDate and stored so reports can group and index on them
  accountingYear  Int        @default(0)
  accountingMonth Int        @default(0)
  /// true when the voucher was encoded in a later calendar year than it is dated —
  /// the year-end cutoff case, called out in the audit trail
  priorYearEntry  Boolean    @default(false)
  /// ENCODED DATE/TIME
  createdAt       DateTime   @default(now())
  // which GL account this expense books to — picked from the Chart of Accounts
  glAccountId     String?
  glAccount       GLAccount? @relation(fields: [glAccountId], references: [id])

  @@unique([companyId, voucherNo])
  @@index([companyId, accountingYear, accountingMonth])
}

/// Accounting period control, one row per company/year/month that has been moved off Open.
/// A period with no row is Open — periods are not created in advance, they are only closed.
model AccountingPeriod {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  year        Int
  month       Int // 1-12
  status      String   @default("Open") // Open | Closing | Locked
  note        String?
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([companyId, year, month])
}

/// Chart of Accounts: the single GL account master for the whole BMS. Shared by both
/// companies — the transactions that reference an account stay company-separated on
/// their own records. Codes and descriptions come from the imported masterlist and
/// are preserved exactly; an account that has been used is deactivated, never deleted.
model GLAccount {
  id               String   @id @default(cuid())
  code             String   @unique // Account Code / Cost Center
  description      String // GL Account Description
  statement        String // Financial Statement: BS | IS
  group            String // Account Group, exactly as the masterlist (e.g. Current Assets)
  status           String   @default("Active") // Active | Inactive
  normalBalance    String   @default("Debit") // Debit | Credit
  allowManualEntry Boolean  @default(true) // may appear in manual journal entries (future module)
  isSystem         Boolean  @default(false) // used automatically by BMS modules; protected from edits
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cashAccounts            CashAccount[]
  expenses                Expense[]
  salesFor                Company[]                 @relation("GLSales")
  freightFor              Company[]                 @relation("GLFreight")
  otherFor                Company[]                 @relation("GLOther")
  inventoryFor            Company[]                 @relation("GLInventory")
  payablesFor             Company[]                 @relation("GLPayables")
  inputVatFor             Company[]                 @relation("GLInputVat")
  SupplierBillExpenseLine SupplierBillExpenseLine[]
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  position    String
  department  String
  hireDate    DateTime
  basicSalary Float
  status      String   @default("Active")

  // per-employee default amounts, used only to prefill payroll entry inputs
  allowLiving         Float @default(0)
  allowGas            Float @default(0)
  allowMotor          Float @default(0)
  allowLoad           Float @default(0)
  allowTravel         Float @default(0)
  dedSss              Float @default(0)
  dedHdmf             Float @default(0)
  dedPhic             Float @default(0)
  dedSssSalaryLoan    Float @default(0)
  dedSssCalamityLoan  Float @default(0)
  dedHdmfMplLoan      Float @default(0)
  dedHdmfCalamityLoan Float @default(0)
  dedSalaryLoan       Float @default(0)
  dedWithholdingTax   Float @default(0)
  dedOthers           Float @default(0)

  /// only employees flagged here appear in the Salesperson picker, whatever their department
  isSalesperson Boolean @default(false)

  payrollEntries PayrollEntry[]
  evaluations    Evaluation[]
  customers      Customer[]
  forecastLines  ForecastLine[]

  drPrepared        DeliveryReceipt[] @relation("DRPrepared")
  drChecked         DeliveryReceipt[] @relation("DRChecked")
  drApproved        DeliveryReceipt[] @relation("DRApproved")
  drDefaultPrepared Company[]         @relation("DRDefaultPrepared")
  drDefaultChecked  Company[]         @relation("DRDefaultChecked")
  drDefaultApproved Company[]         @relation("DRDefaultApproved")
}

model PayrollEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  cutoff     String // e.g. "Aug 1-15, 2026"
  basicPay   Float

  // itemized allowances
  allowLiving Float @default(0)
  allowGas    Float @default(0)
  allowMotor  Float @default(0)
  allowLoad   Float @default(0)
  allowTravel Float @default(0)

  // itemized deductions
  dedSss              Float @default(0)
  dedHdmf             Float @default(0)
  dedPhic             Float @default(0)
  dedSssSalaryLoan    Float @default(0)
  dedSssCalamityLoan  Float @default(0)
  dedHdmfMplLoan      Float @default(0)
  dedHdmfCalamityLoan Float @default(0)
  dedSalaryLoan       Float @default(0)
  dedWithholdingTax   Float @default(0)
  dedOthers           Float @default(0)

  allowances Float    @default(0) // total of all allowances
  grossPay   Float    @default(0) // basicPay + allowances
  deductions Float    @default(0) // total of all deductions
  netPay     Float // grossPay - deductions
  createdAt  DateTime @default(now())
}

model Evaluation {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  period      String
  scoresJson  String // {"criteria": score 1-5}
  remarks     String?
  evaluatorId String?
  evaluator   User?    @relation(fields: [evaluatorId], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  companyId String? // company context; null = global (security alerts, account notices)
  company   Company?  @relation(fields: [companyId], references: [id])
  userId    String? // targeted user, or...
  user      User?     @relation(fields: [userId], references: [id])
  role      String? // ...targeted role (any user with this role sees it)
  type      String
  message   String
  refLink   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Forecast {
  id        String   @id @default(cuid())
  // forecasts are SHARED: one forecast may hold products from either company,
  // so it has no owning company. Each line carries its own product (and therefore company).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  title     String
  year      Int
  area      String // e.g. LUZVIMIN, Luzon, Visayas
  createdAt DateTime @default(now())

  lines ForecastLine[]
}

model ForecastLine {
  id            String    @id @default(cuid())
  forecastId    String
  forecast      Forecast  @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  productId     String // forecast is per product, so the SRP and company are unambiguous
  product       Product   @relation(fields: [productId], references: [id])
  // optional: an area forecast may be planned before it is split between customers
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  // SNAPSHOT, deliberately not read through the customer: reassigning an account later must
  // never rewrite the salesperson on forecasts that were already planned.
  salespersonId String?
  salesperson   Employee? @relation(fields: [salespersonId], references: [id])
  // planning price for this row only. Null = follow the product's current active SRP;
  // a value here overrides it inside this forecast and never touches the product record.
  unitPrice     Float?
  m1            Int       @default(0)
  m2            Int       @default(0)
  m3            Int       @default(0)
  m4            Int       @default(0)
  m5            Int       @default(0)
  m6            Int       @default(0)
  m7            Int       @default(0)
  m8            Int       @default(0)
  m9            Int       @default(0)
  m10           Int       @default(0)
  m11           Int       @default(0)
  m12           Int       @default(0)

  @@unique([forecastId, customerId, productId])
}

/// Business audit trail for master-data changes (who reassigned an account, and when).
/// Distinct from SecurityEvent, which is only for authentication and user-account events.
model AuditLog {
  id         String   @id @default(cuid())
  entity     String // "Customer"
  entityId   String
  action     String // SALESPERSON_ASSIGNED | SALESPERSON_CHANGED | SALESPERSON_CLEARED
  detail     String // human sentence, e.g. "Salesperson: (none) → Marites Uy"
  actorName  String
  actorEmail String
  /// The company the record belonged to. Set on entries that OUTLIVE their record — a
  /// permanent delete leaves no row to read the company from afterwards.
  companyId  String?
  /// The reason the actor gave, where the action demands one (a permanent delete does).
  reason     String?
  /// JSON snapshot of the deleted record's identifying fields, so an audit screen can still
  /// show what is gone: { orderNo, customer, source, amount, lines, orderDate }.
  meta       String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([entity, action, createdAt])
}

/// Company master (one row per company). Mapped onto the original CompanySetting table so the
/// existing Teamagro row (details, logo, print matrix) is preserved unchanged. Never hard-code names.
model Company {
  id                  String     @id @default(cuid())
  companyName         String     @default("")
  /// Short code used inside document numbers (EV-TTC-2026-000001). Set on Company Details;
  /// falls back to the first letters of the name only when it has never been filled in.
  code                String     @default("")
  address             String     @default("Philippines")
  mobileNo            String     @default("")
  telephoneNo         String     @default("")
  email               String     @default("")
  tin                 String     @default("000-000-000-000")
  sssNo               String     @default("")
  phicNo              String     @default("")
  hdmfNo              String     @default("")
  logoDataUrl         String? // 160x160 image stored inline (no persistent disk on the host)
  printVisibilityJson String? // {docType: {field: bool}} — which details print on which document
  status              String     @default("Active") // Active | Inactive
  isPrimary           Boolean    @default(false) // primary company owns employees/HR/payroll and the dealer portal
  // who signs this company's delivery receipts by default — employee links, never names,
  // so a rename in HR flows through and no signatory is hard-coded in a template
  drPreparedById      String?
  drPreparedBy        Employee?  @relation("DRDefaultPrepared", fields: [drPreparedById], references: [id])
  drCheckedById       String?
  drCheckedBy         Employee?  @relation("DRDefaultChecked", fields: [drCheckedById], references: [id])
  drApprovedById      String?
  drApprovedBy        Employee?  @relation("DRDefaultApproved", fields: [drApprovedById], references: [id])
  // which Chart of Accounts entry each billing component credits — picked, never hard-coded,
  // so freight income stops being lumped into product sales in the ledger
  glSalesId           String?
  glSales             GLAccount? @relation("GLSales", fields: [glSalesId], references: [id])
  glFreightId         String?
  glFreight           GLAccount? @relation("GLFreight", fields: [glFreightId], references: [id])
  glOtherId           String?
  glOther             GLAccount? @relation("GLOther", fields: [glOtherId], references: [id])
  // and which entries a posted supplier bill moves — inventory in, the payable, input VAT
  glInventoryId       String?
  glInventory         GLAccount? @relation("GLInventory", fields: [glInventoryId], references: [id])
  glPayablesId        String?
  glPayables          GLAccount? @relation("GLPayables", fields: [glPayablesId], references: [id])
  glInputVatId        String?
  glInputVat          GLAccount? @relation("GLInputVat", fields: [glInputVatId], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  products          Product[]
  accountingPeriods AccountingPeriod[]
  incomingOrders    IncomingOrder[]
  salesOrders       SalesOrder[]
  deliveryReceipts  DeliveryReceipt[]
  salesReceipts     SalesReceipt[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  cashAccounts      CashAccount[]
  receivePayments   ReceivePayment[]
  refundCredits     RefundCredit[]
  expenses          Expense[]
  forecasts         Forecast[]
  bills             SupplierBill[]
  vouchers          DisbursementVoucher[]
  supplierPayments  SupplierPayment[]
  notifications     Notification[]

  @@map("CompanySetting")
}

/// System-wide settings the Super Admin controls from the app, so policy lives in the
/// database rather than in the source. One row per setting, value held as JSON text.
model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

model DocumentCounter {
  docType    String
  year       Int
  companyId  String @default("") // per-company numbering sequences
  lastNumber Int    @default(0)

  @@id([docType, year, companyId])
}

/// A supplier bill for inventory — Enter Bills Against Inventory.
///
/// This is the document that puts purchased goods into stock and raises the payable, in one
/// posting: Dr Inventory (product cost + allocated freight and other costs) / Dr Input VAT /
/// Cr Accounts Payable. A Draft touches nothing. The bill date decides the accounting period
/// and the number series (BL-TTC-2026-000001), the same rule the expense voucher follows.
///
/// Money on the header is stored, not recomputed, so a printed bill never drifts from what
/// was posted. `paidAmount` is maintained by the Pay Bills transaction.
model SupplierBill {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  billNo             String // unique per company (@@unique below)
  /// INVENTORY (goods, matched to a receipt, re-costs stock) | EXPENSE (non-inventory: utilities, rent,
  /// repairs, fees — booked straight to expense accounts, never to stock)
  kind               String         @default("INVENTORY")
  supplierId         String
  supplier           Supplier       @relation(fields: [supplierId], references: [id])
  supplierInvoiceNo  String?
  /// the supplier issued no invoice number (or it is not yet known) — required to post without one
  invoiceUnavailable Boolean        @default(false)
  billDate           DateTime
  dueDate            DateTime
  /// e.g. "30 days", "COD" — the label the due date was computed from
  terms              String         @default("30 days")
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId     String?
  goodsReceipt       GoodsReceipt?  @relation(fields: [goodsReceiptId], references: [id])
  memo               String?
  /// Draft | Posted | Partially Paid | Paid | Void
  status             String         @default("Draft")

  /// Σ line amounts (qty × unit cost − discount), before freight, other costs and VAT
  subtotal        Float  @default(0)
  /// freight billed by this supplier, allocated across the lines into inventory cost
  freight         Float  @default(0)
  /// other directly attributable purchasing costs, allocated the same way
  otherCosts      Float  @default(0)
  /// "value" (by line amount, default) or "qty" (by pieces)
  allocationBasis String @default("value")
  /// 0 or 0.12 — input VAT is a receivable from the BIR, never part of inventory cost
  vatRate         Float  @default(0)
  inputVat        Float  @default(0)
  /// subtotal + freight + otherCosts + inputVat — what the supplier is owed
  total           Float  @default(0)
  /// what the receipt behind this bill had already put into inventory (its accepted qty ×
  /// receiving cost), fixed at posting. The ledger books the bill as clearing that amount
  /// and moving only the difference into inventory. 0 for a bill that stocked the goods itself.
  receiptCost     Float  @default(0)

  /// None | Matched | Partial | Over — the bill's quantities against what its receipt still had to bill
  matchStatus     String  @default("None")
  /// what the clerk noted about a difference from the receipt (to raise with the supplier)
  discrepancyNote String?
  /// an Admin's reason for posting quantities above what was received
  overrideReason  String?
  overrideById    String?
  paidAmount      Float   @default(0)

  accountingYear  Int     @default(0)
  accountingMonth Int     @default(0)
  /// the reason given when posting into a locked period (prior-period adjustment)
  periodReason    String?

  createdById String?
  createdBy   User?     @relation("BillCreated", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  postedById  String?
  postedBy    User?     @relation("BillPosted", fields: [postedById], references: [id])
  postedAt    DateTime?
  voidedById  String?
  voidedBy    User?     @relation("BillVoided", fields: [voidedById], references: [id])
  voidedAt    DateTime?
  voidReason  String?

  lines        SupplierBillLine[]
  expenseLines SupplierBillExpenseLine[]
  dvBills      DVBill[]
  paymentLines SupplierPaymentLine[]

  @@unique([companyId, billNo])
  @@index([companyId, status, dueDate])
  @@index([supplierId, supplierInvoiceNo])
  @@index([goodsReceiptId])
}

model SupplierBillLine {
  id             String       @id @default(cuid())
  billId         String
  bill           SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  /// the receiving / order line this bills, when the bill was raised from one
  grnLineId      String?
  poLineId       String?
  batchNo        String?
  expDate        DateTime?
  /// qty is in `unit`; baseQty is the same in PCS (the inventory unit)
  qty            Int
  unit           String       @default("PCS")
  baseQty        Int          @default(0)
  /// cost per `unit`, before discount
  unitCost       Float
  /// amount taken off this line
  discount       Float        @default(0)
  /// qty × unitCost − discount: the product cost, ex-VAT
  amount         Float        @default(0)
  /// this line's share of freight + other costs
  freightAlloc   Float        @default(0)
  /// input VAT on this line
  taxAmount      Float        @default(0)
  /// amount + freightAlloc — what went into inventory for this line
  inventoryCost  Float        @default(0)
  /// PCS this line actually added to stock when the bill was posted (0 when the receipt had already stocked them)
  stockedBaseQty Int          @default(0)

  @@index([billId])
  @@index([productId])
}

/// A line of a non-inventory supplier bill: which account it is charged to and for how much.
model SupplierBillExpenseLine {
  id          String       @id @default(cuid())
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  glAccountId String
  glAccount   GLAccount    @relation(fields: [glAccountId], references: [id])
  description String
  /// ex-VAT amount charged to the account
  amount      Float
  /// input VAT on this line
  taxAmount   Float        @default(0)

  @@index([billId])
}

/// Disbursement Voucher — the company's payment authorisation, one per payee, covering one or
/// more posted supplier bills. It is a supporting document, not a second accounting entry:
/// the bills already raised the payable, the payment will settle it. Its accounting lines
/// are generated from those, never typed. DV-TTC-2026-000001, per company per year.
model DisbursementVoucher {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  dvNo        String
  /// the number stamped on the paper pad, when one is still used alongside
  padRef      String?
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  payee       String
  date        DateTime
  terms       String?
  particulars String
  memo        String?
  /// Draft | Prepared | Checked | Approved | Posted | Partially Paid | Paid | Void
  status      String   @default("Draft")
  /// Σ of the bill allocations — what this voucher authorises paying
  amount      Float    @default(0)
  paidAmount  Float    @default(0)

  preparedById String?
  preparedBy   User?     @relation("DVPrepared", fields: [preparedById], references: [id])
  preparedAt   DateTime?
  checkedById  String?
  checkedBy    User?     @relation("DVChecked", fields: [checkedById], references: [id])
  checkedAt    DateTime?
  approvedById String?
  approvedBy   User?     @relation("DVApproved", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  notedById    String?
  notedBy      User?     @relation("DVNoted", fields: [notedById], references: [id])
  notedAt      DateTime?
  postedById   String?
  postedBy     User?     @relation("DVPosted", fields: [postedById], references: [id])
  postedAt     DateTime?
  voidedById   String?
  voidedBy     User?     @relation("DVVoided", fields: [voidedById], references: [id])
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bills    DVBill[]
  payments SupplierPayment[]

  @@unique([companyId, dvNo])
  @@index([companyId, status])
  @@index([supplierId])
}

/// How much of one bill a voucher authorises paying.
model DVBill {
  id     String              @id @default(cuid())
  dvId   String
  dv     DisbursementVoucher @relation(fields: [dvId], references: [id], onDelete: Cascade)
  billId String
  bill   SupplierBill        @relation(fields: [billId], references: [id])
  amount Float

  @@unique([dvId, billId])
  @@index([billId])
}

/// A payment to a supplier — what the company actually paid, from which account, against
/// which bills, under which voucher. Dr Accounts Payable / Cr Cash or Bank.
/// PY-TTC-2026-000001, per company per year.
model SupplierPayment {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id])
  paymentNo     String
  date          DateTime
  supplierId    String
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  dvId          String?
  dv            DisbursementVoucher? @relation(fields: [dvId], references: [id])
  cashAccountId String
  cashAccount   CashAccount          @relation(fields: [cashAccountId], references: [id])
  method        String // Cash | Check | Bank Transfer | E-Wallet
  checkNo       String?
  checkDate     DateTime?
  refNo         String?
  amount        Float
  remarks       String?
  /// Posted | Void
  status        String               @default("Posted")
  createdById   String?
  createdBy     User?                @relation("PaymentCreated", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  voidedById    String?
  voidedBy      User?                @relation("PaymentVoided", fields: [voidedById], references: [id])
  voidedAt      DateTime?
  voidReason    String?

  lines SupplierPaymentLine[]

  @@unique([companyId, paymentNo])
  @@index([supplierId, date])
  @@index([dvId])
}

model SupplierPaymentLine {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      SupplierBill    @relation(fields: [billId], references: [id])
  amount    Float

  @@index([billId])
}
